{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Flutter Web",
      "runtimeExecutable": "C:/flutter/bin/flutter",
      "runtimeArgs": ["run", "-d", "chrome", "--web-port", "8080"],
      "port": 8080
    },
    {
      "name": "Flutter Web Server",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "C:\\flutter\\bin\\flutter.bat", "run", "-d", "web-server", "--web-port", "8080", "--web-hostname", "localhost"],
      "port": 8080
    },
    {
      "name": "Flutter Web Server Staging",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "C:\\flutter\\bin\\flutter.bat", "run", "-d", "web-server", "--web-port", "8081", "--web-hostname", "localhost", "--dart-define=API_BASE_URL=https://52aqw5tygf.execute-api.us-east-2.amazonaws.com/staging"],
      "port": 8081
    },
    {
      "name": "Flutter (Default Device)",
      "runtimeExecutable": "C:/flutter/bin/flutter",
      "runtimeArgs": ["run"],
      "port": 8080
    }
  ]
